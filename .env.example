# Copier ce fichier sous le nom .env, puis remplir les valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# LLM (Anthropic)
ANTHROPIC_API_KEY=

# Embeddings et reranking (Voyage AI)
VOYAGE_API_KEY=

# Base vectorielle (Pinecone)
PINECONE_API_KEY=
INDEX_NAME=

# Crawl web (Tavily)
TAVILY_API_KEY=

# Traçage (LangSmith) : mettre false pendant les tests utilisateurs
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
