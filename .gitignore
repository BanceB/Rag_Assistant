# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Environnement virtuel
.venv

# Secrets : ne jamais versionner
.env

# Documents du corpus : soumis au droit d'auteur (ex. norme ARS 1000, « tous droits réservés »).
# On versionne le catalogue (titres, liens, licences), pas les fichiers eux-mêmes.
data/corpus/**/*.pdf
data/corpus/**/*.docx

# Données générées par l'application
data/app.db
data/chroma/
logs/

# Caches des outils
.ruff_cache/
.pytest_cache/

# Fichiers système
Thumbs.db
.DS_Store
